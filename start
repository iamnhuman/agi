#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"

PYTHON="$PROJECT_DIR/.venv-instagram/bin/python"
if ! "$PYTHON" -c 'import sys' >/dev/null 2>&1; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Не найден Python 3. Установите его командой brew install python и повторите ./start."
    exit 1
  fi
  echo "Настраиваю локальный модуль Instagram…"
  python3 -m venv --clear .venv-instagram
fi

if ! "$PYTHON" -c 'import instaloader, browser_cookie3' >/dev/null 2>&1; then
  echo "Устанавливаю зависимости Instagram…"
  "$PYTHON" -m pip install -r requirements-instagram.txt
fi

if [[ -f "$PROJECT_DIR/cookies.txt" ]]; then
  echo "Использую готовый cookies.txt Instagram из папки проекта."
elif [[ ! -f "$PROJECT_DIR/.local/instagram/account.json" ]]; then
  echo
  echo "Для загрузки Instagram положите готовый cookies.txt в папку проекта."
fi

echo
echo "Запускаю сайт. Чтобы остановить его, закройте терминал или нажмите Ctrl+C."
exec npm start
